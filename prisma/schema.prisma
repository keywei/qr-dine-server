datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiningTable {
  id                 Int           @id @default(autoincrement())
  code               String        @unique
  name               String
  capacity           Int           @default(4)
  isActive           Boolean       @default(true)
  serviceBellEnabled Boolean       @default(true)
  orders             Order[]
  serviceCalls       ServiceCall[]
  createdAt          DateTime      @default(now())
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  sortOrder Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())
}

model MenuItem {
  id          Int               @id @default(autoincrement())
  categoryId  Int
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  imageUrl    String?
  isAvailable Boolean           @default(true)
  sortOrder   Int               @default(0)
  options     ItemOptionGroup[]
  orderItems  OrderItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ItemOptionGroup {
  id         Int          @id @default(autoincrement())
  menuItemId Int
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  title      String
  type       String       @default("SINGLE") // SINGLE or MULTIPLE
  isRequired Boolean      @default(false)
  options    ItemOption[]
}

model ItemOption {
  id         Int             @id @default(autoincrement())
  groupId    Int
  group      ItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  extraPrice Float           @default(0)
}

model Order {
  id            Int          @id @default(autoincrement())
  orderNo       String       @unique
  diningType    String       @default("DINE_IN") // DINE_IN or TAKEOUT
  tableId       Int?
  table         DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerNote  String?
  customerPhone String?
  taxId         String? // 統一編號
  invoiceCarrier String? // 手機條碼載具
  
  // Status: PENDING_PAYMENT, COOKING, COMPLETED, CANCELLED
  status        String       @default("PENDING_PAYMENT")
  
  // Payment: ONLINE, CASH
  paymentMethod String       @default("CASH")
  paymentStatus String       @default("UNPAID") // UNPAID, PAID
  paidAt        DateTime?
  
  totalAmount   Float
  items         OrderItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  Int?
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name        String
  price       Float
  quantity    Int      @default(1)
  optionsText String?
}

model StoreSetting {
  id                 Int      @id @default(1)
  storeCode          String   @default("STORE-001") // 門市店號
  name               String   @default("美味食堂 總店") // 門市店名
  address            String   @default("台北市中正區忠孝東路一段 100 號") // 門市地址
  phone              String   @default("02-2345-6789") // 電話
  businessHours      String   @default("週一至週日 11:00 - 21:00") // 營業時間
  serviceBellEnabled Boolean  @default(true) // 全店服務鈴總開關
  updatedAt          DateTime @updatedAt
}

model ServiceCall {
  id        Int          @id @default(autoincrement())
  tableId   Int
  table     DiningTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  type      String       // WATER (加水), UTENSILS (餐具), CLEAN (清潔), ASSIST (現場協助), OTHER (其他)
  note      String?
  status    String       @default("PENDING") // PENDING, COMPLETED, CANCELLED
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model QueueTicket {
  id            Int       @id @default(autoincrement())
  ticketNo      Int
  customerPhone String
  partySize     Int       @default(2)
  status        String    @default("WAITING") // WAITING | CALLING | SEATED | CANCELLED | EXPIRED
  callCount     Int       @default(0)
  calledAt      DateTime?
  seatedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}



